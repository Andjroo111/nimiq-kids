# Hatch PUBLIC competition instance — env template (mini-app port slice 3).
# Copy to ~/gdkc/secrets/hatch-competition.env, chmod 600, fill every <...>.
# This instance is SEPARATE from the family install (hatch.env, port 3950):
# its own checkout, its own DB, its own hot wallet, its own tunnel hostname.

# ---- server ----
PORT=3960
DB_PATH=/Users/USERNAME/data/hatch-competition/hatch.db
MEDIA_DIR=/Users/USERNAME/data/hatch-competition/media
# Public URL of the parent app (rides in ntfy pings + approval deep links).
PARENT_URL=https://<public-hostname>/parent/

# ---- settlement: REAL, mainnet, explicitly armed ----
# HATCH_REQUIRE_REAL makes a SIM misconfiguration fail LOUDLY at boot instead of
# quietly demoing fake money to judges. Never set NIMIQ_SIM here.
HATCH_REQUIRE_REAL=1
NIMIQ_NETWORK=main
MAINNET_ARMED=1
NIMIQ_RPC_URL=<mainnet Albatross JSON-RPC, e.g. the Beelink node behind its tunnel>
# Hot wallet key. Generate with:
#   bun run src/scripts/generate-hot-wallet.ts ~/gdkc/secrets/hatch-competition.env
DEV_PARENT_PRIV=<generated>
# Kid-account master seed. REQUIRED on mainnet — the server derives every kid's on-chain
# account from it. Without it the server refuses to derive kid accounts (it will not fall
# back to the public dev seed on mainnet). Generate a fresh 32-byte hex with:
#   bun run src/scripts/generate-family-seed.ts ~/gdkc/secrets/hatch-competition.env
# BACK IT UP: rotating it orphans every kid's funds.
HATCH_MASTER_SEED=<generated>

# ---- payout economics (the point of this instance) ----
# There is NO per-payout ceiling (removed 2026-07-31): a parent prices their own chores, and
# a payout is refused only when the family cannot fund it. The per-family budget below is
# what bounds this instance's exposure, and it is unchanged.
# Per-family starting budget: 5 NIM. A family's cumulative payouts can never exceed
# grant + its own attributed top-ups. 0 disables un-funded payouts entirely.
HATCH_DEMO_GRANT_LUNA=500000
# Public instance: NOBODY is grandfathered — not even the first family created.
HATCH_GRANDFATHER_FIRST=0

# ---- multi-family boot hygiene ----
# Tablets must pair (parent's 6-digit code). Unauthenticated boot surfaces answer
# 401 pairing_required instead of exposing the first household.
HATCH_LEGACY_BOOT=0
# Leave KIOSK_SETUP_CODE UNSET: the env setup-code pairing path stays disabled;
# device pairing works only through parent-minted pair codes.

# ---- onboarding brakes ----
HATCH_ONBOARD_PER_IP_HOUR=3
HATCH_ONBOARD_PER_DAY=50

# ---- optional ----
# Fiat hint shown in the UI (NIM/USD). Refresh by hand when it drifts.
#HATCH_NIM_USD=0.002
# TLS: not needed — cloudflared fronts this instance; the local origin is plain HTTP.
