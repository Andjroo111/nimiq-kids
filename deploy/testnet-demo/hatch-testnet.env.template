# nimiq.kids — PUBLIC TESTNET DEMO instance (competition judges).
# Copy to ~/gdkc/secrets/hatch-testnet.env, chmod 600, fill every <...>.
# SEPARATE from the mainnet competition instance (hatch-competition.env, :3960) and
# from the family install (hatch.env, :3950): own checkout, own DB, own hot wallet,
# own port, own tunnel path. NEVER point this at a mainnet RPC.

# ---- server ----
PORT=3963
DB_PATH=/Users/USERNAME/data/hatch-testnet/hatch.db
MEDIA_DIR=/Users/USERNAME/data/hatch-testnet/media
# Public URL of the parent app (rides in ntfy pings + approval deep links).
PARENT_URL=https://<public-hostname>/parent/

# ---- settlement: REAL, TESTNET ----
# HATCH_REQUIRE_REAL makes a SIM misconfiguration fail LOUDLY at boot instead of
# quietly demoing fake money to judges. Never set NIMIQ_SIM here.
HATCH_REQUIRE_REAL=1
NIMIQ_NETWORK=test
# Broadcast-capable public testnet RPC (verified accepts sendRawTransaction).
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
# MAINNET_ARMED is deliberately ABSENT. Setting it here would be a category error.

# ---- the judge demo (this instance's whole point) ----
# Each visitor to GET /demo mints their OWN seeded family (parent + Sam + Ava).
# This is a FLAG, not a secret: the only value that means anything is "1".
# It was called HATCH_DEMO_SEED, which reads like it holds a seed — anything that
# rotates secrets by matching on SEED would write 64 hex characters over the "1" and
# silently switch the whole demo off (/demo -> 404, no boot-log complaint). Both names
# still work; prefer this one.
HATCH_DEMO_ENABLED=1
# Abandoned demo families are purged after this long (default 24h).
#
# THIS IS THE RUNWAY DIAL, not just a housekeeping setting. A visitor's seed is paid on chain
# and only comes back when their household is swept (see reclaim below), so the TTL decides how
# much NIM is in flight at once. A judge spends five minutes; 24h is generous. At a 4h TTL the
# same wallet funds roughly six times as many visitors per day.
#HATCH_DEMO_TTL_MS=86400000
# Reclaim a swept household's kid balances to the hot wallet before forgetting it (issue #44).
# ON by default wherever demo families are minted. Set to 0 only if you want the old behaviour,
# where every visitor's seed was scattered into accounts nobody opens again.
#HATCH_DEMO_RECLAIM=0
# How many TTLs a household may linger while its reclaim keeps failing, before the sweeper gives
# up and purges it anyway (default 3). The sweeper must never wedge on an unreachable node.
#HATCH_DEMO_RECLAIM_GRACE_TTLS=3
# Mint brakes (read at import; restart to change).
#HATCH_DEMO_PER_IP_HOUR=12
#HATCH_DEMO_PER_DAY=500

# ---- payout economics ----
# There is NO per-payout ceiling (removed 2026-07-31), so no value here has to be kept
# above the biggest seeded chore any more. The per-family budget is the bound.
#
# Per-family budget: 150 000 NIM. It MUST clear the seeded history, because payKidEarn pays
# that history without consulting the budget but its rows still count as SPENT -- a grant
# below it leaves every family at zero available and the judge's first approval dies with
# budget_exhausted, while the mint still reports a cheerful paidHistory: 4. The remainder is
# what a judge approves chores with.
#
# THIS NUMBER TRAILS THE SEED, AND THE SEED TRAILS THE CATALOGUE. It has been underwater
# twice: 2500000 (25 NIM) predated the shelf reprice, and 60 000 NIM was correct for the
# per-shelf floor but went under the moment the floor became one-of-EVERYTHING (72 000 NIM
# per family as of 2026-08-01). Boot prints which way it went. Read that line after ANY
# change to the seed, the floor or the shelves -- the failure is silent everywhere else.
#
# Headroom is nearly free: the grant is a budget ceiling, not a spend. Only the seeded
# history actually moves NIM.
HATCH_DEMO_GRANT_LUNA=15000000000
HATCH_GRANDFATHER_FIRST=0

# ---- multi-family boot hygiene ----
# The demo depends on this: with it 0, an unauthenticated boot answers 401
# pairing_required instead of exposing whichever family happens to be first.
HATCH_LEGACY_BOOT=0
# Leave KIOSK_SETUP_CODE UNSET.

# ---- onboarding brakes (the self-serve path, alongside the demo) ----
HATCH_ONBOARD_PER_IP_HOUR=30
HATCH_ONBOARD_PER_DAY=500

# ---- generated, never hand-written ----
# bun run src/scripts/generate-hot-wallet.ts ~/gdkc/secrets/hatch-testnet.env
#   -> DEV_PARENT_PRIV + HATCH_HOT_WALLET_ADDRESS
#      QUOTE the address: it contains spaces and `set -a; source` will otherwise
#      try to execute the second word.
# bun run src/scripts/generate-family-seed.ts ~/gdkc/secrets/hatch-testnet.env
#   -> HATCH_MASTER_SEED (kid accounts derive from it; without it every kid-wallet
#      call throws off-SIM)
